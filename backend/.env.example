# Runtime environment: development | production | test
NODE_ENV=development

# Port the NestJS API listens on
PORT=4000

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://cv_builder:cv_builder@localhost:5432/cv_builder?schema=public

# Frontend origin: allowed by CORS and used in links inside emails
FRONTEND_URL=http://localhost:3000

# Auth. Generate the secret with `openssl rand -base64 32`, never commit the real value.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=1800
REFRESH_TTL_DAYS=1

# Mail (Mailpit from docker-compose, web UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="CV Builder <no-reply@cv-builder.local>"

# Object storage for uploaded files (MinIO from docker-compose, console at http://localhost:9001).
# Any S3-compatible service works: for Cloudflare R2 set its endpoint, keys and public bucket URL.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cv_builder
S3_SECRET_KEY=cv_builder_secret
S3_BUCKET=avatars
# Public base URL of the bucket: stored file keys are appended to it
S3_PUBLIC_URL=http://localhost:9000/avatars
# MinIO needs path-style URLs (host/bucket/key); R2 and AWS work with both
S3_FORCE_PATH_STYLE=true

TRUST_PROXY_HOPS=0

# Accounts created by `pnpm db:seed`. Local development only.
SEED_ADMIN_EMAIL=admin@cv-builder.local
SEED_ADMIN_PASSWORD=admin123
SEED_EMPLOYEE_EMAIL=employee@cv-builder.local
SEED_EMPLOYEE_PASSWORD=employee123
