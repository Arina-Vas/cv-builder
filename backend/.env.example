# Runtime environment: development | production | test
NODE_ENV=development

# Port the NestJS API listens on
PORT=4000

# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgresql://cv_builder:cv_builder@localhost:5432/cv_builder?schema=public

# Frontend origin: allowed by CORS and used in links inside emails
FRONTEND_URL=http://localhost:3000

# Auth. Generate the secret with `openssl rand -base64 32`, never commit the real value.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=1800
REFRESH_TTL_DAYS=1

# Mail (Mailpit from docker-compose, web UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="CV Builder <no-reply@cv-builder.local>"

# Accounts created by `pnpm db:seed`. Local development only.
SEED_ADMIN_EMAIL=admin@cv-builder.local
SEED_ADMIN_PASSWORD=admin123
SEED_EMPLOYEE_EMAIL=employee@cv-builder.local
SEED_EMPLOYEE_PASSWORD=employee123
